# Drop those calls so the port builds against current libirecovery (e.g. 1.3.x).
--- src/dfu.c
+++ src/dfu.c
@@ -95,7 +95,6 @@
 		return -1;
 	}
 
-	irecv_init();
 	if (irecv_open_with_ecid(&dfu, client->ecid) != IRECV_E_SUCCESS) {
 		return -1;
 	}
@@ -119,7 +119,6 @@
 	irecv_error_t dfu_error = IRECV_E_SUCCESS;
 	irecv_device_t device = NULL;
 
-	irecv_init();
 	if (irecv_open_with_ecid(&dfu, client->ecid) != IRECV_E_SUCCESS) {
 		return NULL;
 	}
