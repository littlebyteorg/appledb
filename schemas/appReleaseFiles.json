{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AppleDB source app version",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "app",
        "version",
        "releases"
    ],
    "properties": {
        "app": {
            "type": "string",
            "minLength": 1,
            "description": "App display name; app identity comes from the containing app folder."
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "releases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "platform"
                ],
                "properties": {
                    "build": {
                        "type": "string",
                        "minLength": 1
                    },
                    "released": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "string",
                                "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2]))?$"
                            }
                        ]
                    },
                    "beta": {
                        "type": "boolean"
                    },
                    "withdrawn": {
                        "type": "boolean"
                    },
                    "notes": {
                        "type": "string",
                        "minLength": 1
                    },
                    "releaseNotes": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uri"
                            },
                            {
                                "type": "null"
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "url",
                                    "active"
                                ],
                                "properties": {
                                    "url": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "active": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        ]
                    },
                    "securityNotes": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uri"
                            },
                            {
                                "type": "null"
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "url",
                                    "active"
                                ],
                                "properties": {
                                    "url": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "active": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        ]
                    },
                    "icon": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "key",
                            "id"
                        ],
                        "properties": {
                            "key": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                                "not": {
                                    "const": "main"
                                }
                            },
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                                "not": {
                                    "const": "main"
                                }
                            }
                        }
                    },
                    "compatibility": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "platform"
                            ],
                            "properties": {
                                "platform": {
                                    "enum": [
                                        "iOS",
                                        "iPadOS",
                                        "macOS",
                                        "watchOS",
                                        "tvOS",
                                        "visionOS",
                                        "Android",
                                        "Windows",
                                        "web",
                                        "Chrome",
                                        "Firefox",
                                        "Safari",
                                        "other",
                                        "Wear OS",
                                        "Edge",
                                        "Fire TV",
                                        "Android TV",
                                        "Sony TV",
                                        "Mac OS"
                                    ]
                                },
                                "minimumVersion": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "maximumVersion": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "architectures": {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "deviceKeys": {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    },
                    "sources": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "type",
                                "links"
                            ],
                            "properties": {
                                "type": {
                                    "enum": [
                                        "ipsw",
                                        "ota",
                                        "update",
                                        "recovery",
                                        "sfr",
                                        "kdk",
                                        "installassistant",
                                        "combo",
                                        "pkg",
                                        "aar",
                                        "dmg",
                                        "exe",
                                        "appx",
                                        "apk",
                                        "xip",
                                        "aea",
                                        "tar",
                                        "bin",
                                        "ipa",
                                        "xpi",
                                        "msi",
                                        "zip",
                                        "smi"
                                    ]
                                },
                                "arch": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "string"
                                    },
                                    "uniqueItems": true
                                },
                                "deviceMap": {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "osMap": {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "windowsUpdateDetails": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "updateId": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "revisionId": {
                                            "type": "string",
                                            "pattern": "^\\w+$"
                                        }
                                    }
                                },
                                "hashes": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "md5": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{32}$"
                                        },
                                        "sha1": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{40}$"
                                        },
                                        "sha2-256": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{64}$"
                                        },
                                        "sha2-512": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{128}$"
                                        }
                                    }
                                },
                                "links": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "url",
                                            "active"
                                        ],
                                        "properties": {
                                            "url": {
                                                "type": "string",
                                                "format": "uri"
                                            },
                                            "decryptionKey": {
                                                "type": "string"
                                            },
                                            "active": {
                                                "type": "boolean"
                                            },
                                            "catalog": {
                                                "enum": [
                                                    "dev-beta",
                                                    "public-beta"
                                                ]
                                            }
                                        }
                                    }
                                },
                                "size": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            }
                        }
                    },
                    "sdks": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "beta": {
                                    "type": "boolean"
                                },
                                "build": {
                                    "type": "string"
                                },
                                "buildId": {
                                    "type": "string",
                                    "format": "uuid"
                                },
                                "osStr": {
                                    "type": "string"
                                },
                                "rc": {
                                    "type": "boolean"
                                },
                                "version": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "platform": {
                        "enum": [
                            "iOS",
                            "iPadOS",
                            "macOS",
                            "watchOS",
                            "tvOS",
                            "visionOS",
                            "Android",
                            "Windows",
                            "web",
                            "Chrome",
                            "Firefox",
                            "Safari",
                            "other",
                            "Wear OS",
                            "Edge",
                            "Fire TV",
                            "Android TV",
                            "Sony TV",
                            "Mac OS"
                        ]
                    },
                    "edition": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "buildTrain": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    },
                    "osMap": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": "Supported host OS families, preserving catalog labels."
                    },
                    "rc": {
                        "type": "boolean"
                    },
                    "internal": {
                        "type": "boolean"
                    },
                    "preinstalledOS": {
                        "type": "boolean"
                    },
                    "safariVersion": {
                        "type": "string",
                        "minLength": 1
                    },
                    "legacyId": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    }
}
